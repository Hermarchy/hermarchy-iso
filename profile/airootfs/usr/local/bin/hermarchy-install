#!/bin/bash

set -euo pipefail

readonly LIB_DIR=/usr/local/lib/hermarchy-installer
# shellcheck source=profile/airootfs/usr/local/lib/hermarchy-installer/common.sh
source "$LIB_DIR/common.sh"

readonly LOG_FILE=/var/log/hermarchy-install.log
readonly TARGET=/mnt
INSTALL_SUCCEEDED=0

usage() {
  printf 'Usage: hermarchy-install --disk DISK --hostname NAME --username USER --password-fd FD\n' >&2
}

cleanup() {
  local status=$?
  set +e
  sync
  if mountpoint -q "$TARGET"; then
    umount -R "$TARGET"
  fi
  if (( status != 0 || INSTALL_SUCCEEDED == 0 )); then
    printf '[hermarchy] Installation failed. Log: %s\n' "$LOG_FILE" >&2
  fi
  return "$status"
}
trap cleanup EXIT

require_commands() {
  local command
  for command in arch-chroot blkid bootctl findmnt genfstab jq lsblk mkfs.ext4 mkfs.fat mount mountpoint pacstrap partprobe readlink sgdisk udevadm umount wipefs; do
    command -v "$command" >/dev/null || fail "required command is missing: $command"
  done
}

install_system() {
  local disk=$1 hostname=$2 username=$3 password=$4
  local disk_json esp root root_uuid

  [[ $EUID == 0 ]] || fail "installer must run as root"
  [[ -d /sys/firmware/efi ]] || fail "Hermarchy currently supports UEFI installation only"
  validate_install_disk "$disk"
  validate_hostname "$hostname" || fail "invalid hostname: $hostname"
  validate_username "$username" || fail "invalid username: $username"
  [[ -n $password ]] || fail "password must not be empty"
  [[ $password != *:* && $password != *$'\n'* ]] || fail "password contains an unsupported colon or newline"
  mountpoint -q "$TARGET" && fail "$TARGET is already mounted"

  log "Erasing and partitioning $disk"
  wipefs --all --force "$disk"
  sgdisk --zap-all "$disk"
  sgdisk --clear \
    --new=1:0:+1GiB --typecode=1:ef00 --change-name=1:'EFI System' \
    --new=2:0:0 --typecode=2:8300 --change-name=2:'Hermarchy Root' \
    "$disk"
  partprobe "$disk"
  udevadm settle

  disk_json=$(lsblk --json --paths --output PATH,PARTN "$disk")
  esp=$(partition_path_from_json "$disk_json" 1)
  root=$(partition_path_from_json "$disk_json" 2)
  [[ -b $esp && -b $root ]] || fail "new partition devices were not created"

  log "Formatting $esp as FAT32"
  mkfs.fat -F 32 -n HERMARCHY_EFI "$esp"
  log "Formatting $root as ext4"
  mkfs.ext4 -F -L HERMARCHY_ROOT "$root"

  mount "$root" "$TARGET"
  mkdir -p "$TARGET/boot"
  mount "$esp" "$TARGET/boot"

  log "Installing the base Arch system"
  pacstrap -K "$TARGET" \
    base linux linux-firmware networkmanager sudo

  genfstab -U "$TARGET" >"$TARGET/etc/fstab"

  printf 'en_US.UTF-8 UTF-8\n' >"$TARGET/etc/locale.gen"
  arch-chroot "$TARGET" locale-gen
  printf 'LANG=en_US.UTF-8\n' >"$TARGET/etc/locale.conf"
  ln -sf /usr/share/zoneinfo/UTC "$TARGET/etc/localtime"
  arch-chroot "$TARGET" hwclock --systohc

  printf '%s\n' "$hostname" >"$TARGET/etc/hostname"
  cat >"$TARGET/etc/hosts" <<EOF
127.0.0.1 localhost
::1 localhost
127.0.1.1 $hostname.localdomain $hostname
EOF

  arch-chroot "$TARGET" useradd --create-home --groups wheel --shell /bin/bash "$username"
  printf '%s:%s\n' "$username" "$password" | arch-chroot "$TARGET" chpasswd
  unset password

  install -d -m 0750 "$TARGET/etc/sudoers.d"
  printf '%%wheel ALL=(ALL:ALL) ALL\n' >"$TARGET/etc/sudoers.d/10-wheel"
  chmod 0440 "$TARGET/etc/sudoers.d/10-wheel"
  arch-chroot "$TARGET" visudo --check --file=/etc/sudoers.d/10-wheel
  arch-chroot "$TARGET" systemctl enable NetworkManager

  log "Installing systemd-boot"
  bootctl --esp-path="$TARGET/boot" install
  root_uuid=$(blkid -s UUID -o value "$root")
  [[ -n $root_uuid ]] || fail "could not determine root filesystem UUID"

  mkdir -p "$TARGET/boot/loader/entries"
  cat >"$TARGET/boot/loader/loader.conf" <<EOF
 default hermarchy.conf
 timeout 3
 console-mode keep
 editor no
EOF
  cat >"$TARGET/boot/loader/entries/hermarchy.conf" <<EOF
title Hermarchy
linux /vmlinuz-linux
initrd /initramfs-linux.img
options root=UUID=$root_uuid rw
EOF

  printf '%s\n' \
    'channel=dev' \
    'installer=hermarchy-basic' \
    >"$TARGET/etc/hermarchy-release"

  sync
  INSTALL_SUCCEEDED=1
  log "Installation completed successfully"
}

main() {
  local disk='' hostname='' username='' password_fd='' password
  while (( $# > 0 )); do
    case $1 in
      --disk) disk=${2:-}; shift 2 ;;
      --hostname) hostname=${2:-}; shift 2 ;;
      --username) username=${2:-}; shift 2 ;;
      --password-fd) password_fd=${2:-}; shift 2 ;;
      -h|--help) usage; return 0 ;;
      *) usage; return 2 ;;
    esac
  done

  [[ -n $disk && -n $hostname && -n $username && -n $password_fd ]] || {
    usage
    return 2
  }
  [[ $password_fd =~ ^[0-9]+$ ]] || fail "password file descriptor must be numeric"
  IFS= read -r -d '' password <&"$password_fd" || true

  require_commands
  install_system "$disk" "$hostname" "$username" "$password"
  unset password
}

mkdir -p "$(dirname "$LOG_FILE")"
touch "$LOG_FILE"
chmod 0600 "$LOG_FILE"
exec > >(tee -a "$LOG_FILE") 2>&1
main "$@"
