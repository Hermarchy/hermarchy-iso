#!/bin/bash

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
PROFILE="$ROOT/profile"
# shellcheck source=bin/lib/archiso-container.sh
source "$ROOT/bin/lib/archiso-container.sh"

select_archiso_container

# Package expressions expand inside the container shell, not in this shell.
# shellcheck disable=SC2016
"${ARCHISO_CONTAINER[@]}" run --rm \
  -e ARCHISO_BUILD_IMAGE="$ARCHISO_BUILD_IMAGE" \
  -v "$PROFILE:/profile:ro" \
  "$ARCHISO_BUILD_IMAGE" \
  bash -euo pipefail -c '
    packages=()
    while IFS= read -r package || [[ -n $package ]]; do
      package=${package%%#*}
      package=${package#"${package%%[![:space:]]*}"}
      package=${package%"${package##*[![:space:]]}"}
      [[ -n $package ]] && packages+=("$package")
    done </profile/packages.x86_64

    (( ${#packages[@]} > 0 )) || {
      echo "the ArchISO profile package list is empty" >&2
      exit 1
    }

    pacman --config /profile/pacman.conf -Sy --noconfirm

    if ! pacman --config /profile/pacman.conf -Sp --needed --noconfirm \
      "${packages[@]}" >/tmp/hermarchy-resolved-packages 2>/tmp/hermarchy-resolve-errors; then
      cat /tmp/hermarchy-resolve-errors >&2
      echo "profile package resolution failed; checking direct package names:" >&2
      direct_failures=0
      for package in "${packages[@]}"; do
        if ! pacman --config /profile/pacman.conf -Sp --needed --noconfirm \
          "$package" >/dev/null 2>&1; then
          printf "  unresolved: %s\n" "$package" >&2
          direct_failures=$((direct_failures + 1))
        fi
      done
      if (( direct_failures == 0 )); then
        echo "all direct names exist; the combined dependency transaction is inconsistent" >&2
      fi
      exit 1
    fi

    if [[ " ${packages[*]} " == *" broadcom-wl-dkms "* ]]; then
      # pkgrel 48 lacks the Linux 7.2 compatibility patch; pkgrel 49 adds it.
      minimum_broadcom_version=6.30.223.271-49
      broadcom_version=$(
        LC_ALL=C pacman --config /profile/pacman.conf -Si broadcom-wl-dkms |
          while IFS=: read -r field value; do
            field=${field//[[:space:]]/}
            [[ $field == Version ]] || continue
            value=${value#"${value%%[![:space:]]*}"}
            printf "%s\n" "$value"
            break
          done
      )
      [[ -n $broadcom_version ]] || {
        echo "could not determine the broadcom-wl-dkms repository version" >&2
        exit 1
      }
      if (( $(vercmp "$broadcom_version" "$minimum_broadcom_version") < 0 )); then
        echo "broadcom-wl-dkms $broadcom_version is known not to build against the current Arch kernel" >&2
        echo "wait for $minimum_broadcom_version or newer to reach the enabled official repositories" >&2
        exit 1
      fi
    fi

    printf "Resolved %s ArchISO profile packages with %s\n" \
      "${#packages[@]}" "$ARCHISO_BUILD_IMAGE"
  '
