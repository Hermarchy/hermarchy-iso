#!/bin/bash

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
ISO=${1:-}
DISK=${HERMARCHY_VM_DISK:-/tmp/hermarchy-dev.qcow2}
VARS=${HERMARCHY_VM_OVMF_VARS:-/tmp/hermarchy-dev-OVMF_VARS.fd}

if [[ -z $ISO ]]; then
  mapfile -t images < <(printf '%s\n' "$ROOT"/release/*.iso)
  (( ${#images[@]} == 1 )) || { echo 'pass an ISO path explicitly' >&2; exit 1; }
  ISO=${images[0]}
fi
[[ -f $ISO ]] || { echo "ISO not found: $ISO" >&2; exit 1; }

for command in qemu-img qemu-system-x86_64; do
  command -v "$command" >/dev/null || { echo "missing command: $command" >&2; exit 1; }
done

code=''
vars_template=''
for candidate in \
  /usr/share/OVMF/OVMF_CODE_4M.fd \
  /usr/share/edk2/x64/OVMF_CODE.4m.fd; do
  [[ -f $candidate ]] && { code=$candidate; break; }
done
for candidate in \
  /usr/share/OVMF/OVMF_VARS_4M.fd \
  /usr/share/edk2/x64/OVMF_VARS.4m.fd; do
  [[ -f $candidate ]] && { vars_template=$candidate; break; }
done
[[ -n $code && -n $vars_template ]] || { echo 'OVMF firmware was not found' >&2; exit 1; }

if [[ ! -f $DISK ]]; then
  qemu-img create -f qcow2 "$DISK" 40G
fi
cp -f "$vars_template" "$VARS"

accel=(-accel tcg -cpu max)
if [[ -r /dev/kvm && -w /dev/kvm ]]; then
  accel=(-enable-kvm -cpu host)
fi

printf 'ISO:  %s\nDisk: %s\n' "$ISO" "$DISK"
exec qemu-system-x86_64 \
  "${accel[@]}" \
  -machine q35 \
  -smp 4 \
  -m 4096 \
  -drive if=pflash,format=raw,readonly=on,file="$code" \
  -drive if=pflash,format=raw,file="$VARS" \
  -drive file="$DISK",format=qcow2,if=virtio,bootindex=1 \
  -drive file="$ISO",format=raw,media=cdrom,readonly=on,bootindex=2 \
  -nic user,model=virtio-net-pci \
  -boot menu=on
