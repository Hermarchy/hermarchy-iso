#!/bin/bash

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
PROFILE="$ROOT/profile"
# shellcheck source=bin/lib/archiso-container.sh
source "$ROOT/bin/lib/archiso-container.sh"

select_archiso_container

# DKMS expressions expand inside the container shell, not in this shell.
# shellcheck disable=SC2016
"${ARCHISO_CONTAINER[@]}" run --rm \
  --security-opt=no-new-privileges \
  -v "$PROFILE:/profile:ro" \
  "$ARCHISO_BUILD_IMAGE" \
  bash -euo pipefail -c '
    pacman --config /profile/pacman.conf -Syu --needed --noconfirm \
      broadcom-wl-dkms dkms kmod linux linux-headers mkinitcpio

    shopt -s nullglob globstar
    kernel_trees=(/usr/lib/modules/*)
    (( ${#kernel_trees[@]} == 1 )) || {
      printf "expected one installed kernel tree, found %s\n" "${#kernel_trees[@]}" >&2
      exit 1
    }
    kernel_tree=${kernel_trees[0]}
    kernel_version=${kernel_tree##*/}
    [[ -d $kernel_tree/build/include ]] || {
      echo "matching kernel headers are missing for $kernel_version" >&2
      exit 1
    }

    module_sources=(/usr/src/broadcom-wl-*)
    (( ${#module_sources[@]} == 1 )) || {
      printf "expected one broadcom-wl DKMS source tree, found %s\n" "${#module_sources[@]}" >&2
      exit 1
    }
    module_version=${module_sources[0]##*/broadcom-wl-}

    dkms install --force "broadcom-wl/$module_version" -k "$kernel_version"
    depmod -a "$kernel_version"

    wl_modules=("$kernel_tree"/**/wl.ko*)
    (( ${#wl_modules[@]} > 0 )) || {
      echo "broadcom-wl DKMS completed without installing wl.ko for $kernel_version" >&2
      exit 1
    }
    modinfo -k "$kernel_version" wl >/dev/null

    printf "Validated broadcom-wl %s for kernel %s: %s\n" \
      "$module_version" "$kernel_version" "${wl_modules[0]}"
  '
